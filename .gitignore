.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# Local secrets and organization runtime state.
.env
.env.*
!.env.example
**/signing.key
**/channel_state.json
*.pem

# Local agent/workspace metadata and extracted filesystem metadata.
.agents/
.codex/
*:Zone.Identifier

# Python bytecode and local tooling output.
*.py[cod]
.coverage
htmlcov/

/.local/

/results/**/workers/
/results/**/pytest_work/
/results/**/organizations/*/private.*
/results/**/organizations/*/signing.key
/results/**/organizations/*/channel_state.json

# Local experiment archives are large and are not part of the public tree.
/results/*
!/results/final_unified_live_v1_combined_20260911/
!/results/final_unified_live_v1_combined_20260911/**

# Local handoff and experiment-planning notes stay outside the public tree.
/TASK_*.md
/REVIEW_*.md
/FINAL_LIVE_*.md
/EXPERIMENT*.md
/DELIVERY*.md
/RESEARCH_*.md
/PROJECT_SUMMARY_*.md
/*HANDOFF*.md
/*IMPLEMENTATION_CHECKPOINT*.md
